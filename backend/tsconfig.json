{
  "compilerOptions": {
    "target": "ES2020",               // или "ES2022"
    "module": "commonjs",             // Node.js использует CommonJS
    "outDir": "./dist",               // папка для скомпилированных JS-файлов
    "rootDir": "./src",               // папка с исходным TS-кодом
    "strict": true,                   // строгий режим (рекомендуется)
    "esModuleInterop": true,          // для удобного импорта из commonjs-модулей
    "skipLibCheck": true,             // ускоряет компиляцию
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}